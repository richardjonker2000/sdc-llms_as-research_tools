{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-cn-coding-plan/MiniMax-M3.1-Flash",
  "default_agent": "planner",
  "share": "disabled",
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "question": "deny",
    "task": "deny",
    "read": {
      "*": "allow",
      "config.env": "deny",
      "*.env": "deny"
    },
    "edit": {
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      ".venv/bin/python *": "allow",
      ".venv/bin/python -m pip *": "ask",
      "ls *": "allow",
      "head *": "allow",
      "wc *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "pwd *": "allow",
      "file *": "allow",
      "find *": "allow",
      "du *": "allow",
      "diff *": "allow",
      "date *": "allow",
      "which *": "allow",
      "true *": "allow",
      "find * -delete*": "deny",
      "find * -exec*": "deny",
      "cat *.env*": "deny",
      "cat config.env": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git config *": "deny",
      "git -c *": "deny",
      "git push *": "deny",
      "git reset *": "deny",
      "git checkout *": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  }
}