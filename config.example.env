# Copy this file to config.env and fill in API_KEY. config.env is git-ignored: never share it.
PROVIDER=minimax_cn        # gemini | minimax_intl | minimax_cn | deepseek | qwen | modelscope | ollama
API_KEY=
MODEL=                     # blank = provider default
RPM=60                     # requests per minute: 60 for paid keys (MiniMax, DeepSeek); 10 for free tiers (Gemini)
DRY_RUN=0
OLLAMA_URL=http://localhost:11434
DECISION_MODEL=tev1:0.8b   # alternatives: tev1, nimble
REASONING=low              # MiniMax thinking: low (fast, cheap) | medium | high | max | off (M3 only)
PRICE_IN=                  # US$ per million tokens, for the cost lines under each cell; blank = list price of the model
PRICE_OUT=
