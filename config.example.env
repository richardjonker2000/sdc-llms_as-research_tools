# Copy this file to config.env and fill in API_KEY. config.env is git-ignored: never share it.
PROVIDER=minimax_cn        # gemini | minimax_intl | minimax_cn | deepseek | qwen | modelscope
API_KEY=
MODEL=                     # blank = provider default
RPM=60                     # requests per minute: 60 for paid keys (MiniMax, DeepSeek); 10 for free tiers (Gemini)
DRY_RUN=0
REASONING=low              # MiniMax thinking: low (fast, cheap) | medium | high | max | off (M3 only)
PRICE_IN=                  # price per million tokens, for the cost lines under each cell; blank = official price of the model
PRICE_OUT=
CURRENCY=                  # blank = the model's currency (¥ for minimax_cn)
OPENALEX_API_KEY=           # optional, free at openalex.org/settings/api: lets notebook 04 fetch your own topic
CACHE_DIR=                  # blank = outputs_cached/ in this folder; a path = saved answers shared from there
